# URL produksi lengkap untuk canonical URL, Open Graph, robots, dan sitemap.
# Pada Vercel, Cloudflare Pages, dan Netlify nilai ini dapat terdeteksi otomatis.
NEXT_PUBLIC_SITE_URL=https://domain-anda.com

# Penyimpanan order server-side. Jangan pernah memakai service role di frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Midtrans Sandbox. Ubah kedua flag menjadi true saat merchant production aktif.
# MIDTRANS_SERVER_KEY=
# MIDTRANS_IS_PRODUCTION=false
# NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# WhatsApp Cloud API untuk mengirim template invoice setelah pembayaran sukses.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=nalara_invoice_paid
WHATSAPP_TEMPLATE_LANGUAGE=id
